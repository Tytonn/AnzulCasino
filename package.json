{
  "name": "anzulcasino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check . && node scripts/check-tokens.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "e2e:serve": "node scripts/db/reset-e2e.ts && vite --port 8899 --strictPort",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/db/migrate-local.ts",
    "db:seed:local": "node scripts/db/seed-local.ts",
    "db:reset:local": "node scripts/db/reset-local.ts",
    "db:setup:local": "bash scripts/dev/setup-postgres.sh",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@ably/pubsub-device": "3.1.0",
    "@ably/pubsub-server": "3.1.0",
    "@netlify/database": "2.0.3",
    "@netlify/functions": "6.1.1",
    "@tanstack/react-query": "5.108.0",
    "drizzle-orm": "1.0.0-beta.22",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/database-dev": "1.0.2",
    "@netlify/vite-plugin": "3.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
