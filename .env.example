# Local development only. Copy to .env (npm run db:setup:local does it for
# you) and adjust. Never commit .env.
# On Netlify these come from Project configuration > Environment variables.

# Real Postgres for local dev and tests. Leave DATABASE_URL unset to use
# Netlify's embedded local database instead (the Vite plugin starts it).
# Only localhost addresses are accepted: hosted databases get their
# migrations from Netlify's deploys, never from these scripts.
DATABASE_URL=postgres://casino:casino@localhost:5432/casino_dev
TEST_DATABASE_URL=postgres://casino:casino@localhost:5432/casino_test
E2E_DATABASE_URL=postgres://casino:casino@localhost:5432/casino_e2e

# Signing up with this code as the invite code makes the first admin.
ADMIN_BOOTSTRAP_CODE=local-admin-code

# Leave unset locally: the server then publishes to the local live relay
# (npm run dev starts it) instead of Ably.
# ABLY_API_KEY=
